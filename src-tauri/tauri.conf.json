{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gamagement",
  "version": "1.1.5",
  "identifier": "dev.m0-kii.gamagement",
  "build": {
    "beforeDevCommand": "pnpm build:frontend",
    "beforeBuildCommand": "pnpm build:frontend",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Gamagement",
        "width": 1200,
        "height": 800,
        "minWidth": 650,
        "minHeight": 500,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "capabilities": [
        {
          "identifier": "main-window-events",
          "windows": [
            "main"
          ],
          "permissions": [
            "core:event:allow-listen",
            "core:event:allow-unlisten"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "../assets/icon.ico"
    ],
    "copyright": "© 2026 M0_kii",
    "shortDescription": "Game Center Management App",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
